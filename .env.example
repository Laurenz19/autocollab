# Le fournisseur d'IA, le modèle et les clés d'API se règlent dans l'application :
# Administration › Intelligence artificielle (enregistrés dans data/settings.json).

# Navigateur des agents. Vide = Chromium intégré (`playwright install chromium`), à utiliser sur un serveur.
# Sinon chemin d'un navigateur Chromium, ex. C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
BROWSER_PATH=
# Un profil de navigateur par utilisateur (ses connexions aux sites) dans ce dossier
BROWSER_PROFILES_DIR=data/profils
# Nombre d'exécutions simultanées (une par utilisateur au plus). ~300-500 Mo de mémoire chacune.
MAX_PARALLEL_RUNS=2
# true = l'agent travaille en arrière-plan, sans fenêtre visible
BROWSER_HEADLESS=true

# Nombre maximum d'étapes par tâche
AGENT_MAX_STEPS=40

APP_HOST=127.0.0.1
APP_PORT=8800

# Désactive les statistiques d'usage anonymes envoyées par browser-use
ANONYMIZED_TELEMETRY=false

# Connexion des utilisateurs (comptes gérés avec : python manage_users.py)
# Vide = clé générée automatiquement dans data/secret.key
SESSION_SECRET=
# Durée d'une session avant de devoir se reconnecter
SESSION_HOURS=12
# Mettre true dès que le serveur est servi en HTTPS
COOKIE_SECURE=false

# Délai pour répondre à une demande de validation, en minutes (au-delà : refus automatique)
APPROVAL_TIMEOUT_MINUTES=60
