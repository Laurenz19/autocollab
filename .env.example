# Le fournisseur d'IA, le modèle et les clés d'API se règlent dans l'application :
# Administration › Intelligence artificielle (enregistrés dans data/settings.json).

# Navigateur des agents. Vide = Chromium intégré (`playwright install chromium`), à utiliser sur un serveur.
# Sinon chemin d'un navigateur Chromium, ex. C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
BROWSER_PATH=
# Un profil de navigateur par utilisateur (ses connexions aux sites) dans ce dossier
BROWSER_PROFILES_DIR=data/profils
# Nombre d'exécutions simultanées (une par utilisateur au plus). ~300-500 Mo de mémoire chacune.
MAX_PARALLEL_RUNS=2
# true = l'agent travaille en arrière-plan, sans fenêtre visible
BROWSER_HEADLESS=true

# Nombre maximum d'étapes par tâche
AGENT_MAX_STEPS=40

# Nom de l'organisation (sous le logo, page de connexion). Modifiable ensuite dans Administration.
ORG_NAME=

APP_HOST=127.0.0.1
APP_PORT=8800

# Désactive les statistiques d'usage anonymes envoyées par browser-use
ANONYMIZED_TELEMETRY=false

# Connexion des utilisateurs (comptes gérés avec : python manage_users.py)
# Vide = clé générée automatiquement dans data/secret.key
SESSION_SECRET=
# Durée d'une session avant de devoir se reconnecter
SESSION_HOURS=12
# Mettre true dès que le serveur est servi en HTTPS
COOKIE_SECURE=false

# Délai pour répondre à une demande de validation, en minutes (au-delà : refus automatique)
APPROVAL_TIMEOUT_MINUTES=60

# Facturation Stripe (Administration > Abonnement). Vide = facturation désactivée, aucune limite
# (installation chez le client, ou avant le lancement). Clé : Stripe > Développeurs > Clés API (sk_live_… ou sk_test_…).
STRIPE_SECRET_KEY=
# Webhook : Stripe > Développeurs > Webhooks, adresse <PUBLIC_URL>/api/stripe/webhook, événements
# checkout.session.completed, customer.subscription.created/updated/deleted, invoice.paid. Puis copier le whsec_…
STRIPE_WEBHOOK_SECRET=
# Identifiants des prix (price_…) créés dans Stripe > Catalogue de produits, en USD. Une formule sans prix
# n'est pas proposée (ex. Entreprise sur devis).
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_YEARLY=
STRIPE_PRICE_EQUIPE_MONTHLY=
STRIPE_PRICE_EQUIPE_YEARLY=
STRIPE_PRICE_ENTREPRISE_MONTHLY=
STRIPE_PRICE_ENTREPRISE_YEARLY=
# Pack de 10 000 crédits, paiement unique (39 $)
STRIPE_PRICE_CREDITS=

# Base de données. Vide = SQLite dans data/app.db (une installation sur un poste).
# Serveur partagé entre plusieurs clients : PostgreSQL.
#DATABASE_URL=postgresql://autocollab:<mot de passe>@localhost:5432/autocollab
#DATABASE_POOL_SIZE=10
# With docker compose, PostgreSQL runs next to the app: only its password is needed here.
#POSTGRES_PASSWORD=
